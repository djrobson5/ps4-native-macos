+/* SSE4.2 string compare (the legacy and, with -mavx, the VEX encodings) and ADDSUBPD, over several
+ * imm8 values (formats, aggregations, polarities, output selection), implicit and explicit
+ * lengths. The strings use a small alphabet with zeros, so matches and ends of strings occur. */
+#define PCMP_ROUND(imm)                                                                           \
+    do {                                                                                          \
+        r = r * 31 + (uint32_t)_mm_cmpistri(va, vb, imm);                                         \
+        r = r * 31 + (uint32_t)_mm_cmpistrc(va, vb, imm) + 2 * (uint32_t)_mm_cmpistrz(va, vb, imm) \
+            + 4 * (uint32_t)_mm_cmpistrs(va, vb, imm) + 8 * (uint32_t)_mm_cmpistro(va, vb, imm);  \
+        r = r * 31 + (uint32_t)_mm_cmpestri(va, la, vb, lb, imm);                                 \
+        r = r * 31 + (uint32_t)_mm_cmpestrc(va, la, vb, lb, imm) + 2 * (uint32_t)_mm_cmpestrz(va, la, vb, lb, imm) \
+            + 4 * (uint32_t)_mm_cmpestrs(va, la, vb, lb, imm) + 8 * (uint32_t)_mm_cmpestro(va, la, vb, lb, imm); \
+        r = r * 31 + (uint64_t)_mm_cvtsi128_si64(_mm_cmpistrm(va, vb, imm));                      \
+        r = r * 31 + (uint64_t)_mm_extract_epi64(_mm_cmpestrm(va, la, vb, lb, imm), 1);          \
+    } while (0)
+T uint64_t t_pcmpstr(uint64_t a, uint64_t b, uint64_t c) {
+    unsigned char sa[16] __attribute__((aligned(16))), sb[16] __attribute__((aligned(16)));
+    const unsigned alphabet = 2 + (unsigned)(c & 3);
+    for (int i = 0; i < 16; ++i) {
+        const unsigned x = (unsigned)((a >> ((i & 7) * 8)) * (unsigned)(i + 3) + (b >> (i & 31))) & 15;
+        const unsigned y = (unsigned)((b >> ((i & 7) * 8)) * (unsigned)(i + 5) + (a >> (i & 31))) & 15;
+        sa[i] = x > alphabet * 2 ? 0 : (unsigned char)(0x41 + x % alphabet + ((c >> 40) & 1 ? 0x80 : 0));
+        sb[i] = y > alphabet * 2 ? 0 : (unsigned char)(0x41 + y % alphabet + ((c >> 40) & 1 ? 0x80 : 0));
+    }
+    if ((c >> 8) & 1) for (int i = (int)((c >> 9) & 15); i < 16; ++i) sa[i] = 0;
+    if ((c >> 13) & 1) for (int i = (int)((c >> 14) & 15); i < 16; ++i) sb[i] = 0;
+    const __m128i va = _mm_load_si128((const __m128i *)sa), vb = _mm_load_si128((const __m128i *)sb);
+    const int la = (int)(int8_t)(c >> 18), lb = (int)(int8_t)(c >> 26);
+    uint64_t r = 0;
+    PCMP_ROUND(0x00); PCMP_ROUND(0x04); PCMP_ROUND(0x08); PCMP_ROUND(0x0c); PCMP_ROUND(0x14);
+    PCMP_ROUND(0x18); PCMP_ROUND(0x1c); PCMP_ROUND(0x28); PCMP_ROUND(0x38); PCMP_ROUND(0x44);
+    PCMP_ROUND(0x46); PCMP_ROUND(0x4a); PCMP_ROUND(0x62); PCMP_ROUND(0x01); PCMP_ROUND(0x05);
+    PCMP_ROUND(0x0d); PCMP_ROUND(0x19); PCMP_ROUND(0x03); PCMP_ROUND(0x0e); PCMP_ROUND(0x4d);
+    union { __m128d v; double d[2]; } x, y, z;
+    x.d[0] = (double)(int64_t)a; x.d[1] = (double)(int32_t)b; y.d[0] = (double)(int32_t)c; y.d[1] = (double)(int64_t)(a ^ c);
+    z.v = _mm_addsub_pd(x.v, y.v);
+    r = r * 31 + (uint64_t)(int64_t)z.d[0] + 3 * (uint64_t)(int64_t)z.d[1];
+    const __m256d w = _mm256_addsub_pd(_mm256_set_pd(x.d[1], x.d[0], y.d[1], y.d[0]), _mm256_set_pd(y.d[0], x.d[1], x.d[0], y.d[1]));
+    union { __m256d v; double d[4]; } u = {w};
+    return r * 31 + (uint64_t)(int64_t)u.d[0] + 3 * (uint64_t)(int64_t)u.d[1] + 5 * (uint64_t)(int64_t)u.d[2] + 7 * (uint64_t)(int64_t)u.d[3];
+}
+
+/* PMOVZX/SX to quadwords (BQ, WQ), register and memory sources, legacy and (with -mavx) VEX. */
+T uint64_t t_pmovq(uint64_t a, uint64_t b, uint64_t c) {
+    uint64_t m[2] = {a ^ (c << 7), b + c};
+    __m128i x = _mm_set_epi64x((long long)b, (long long)a), r1, r2, r3, r4, r5, r6, r7, r8;
+    __asm__ volatile("pmovzxbq %1, %0" : "=x"(r1) : "x"(x));
+    __asm__ volatile("pmovzxwq %1, %0" : "=x"(r2) : "x"(x));
+    __asm__ volatile("pmovsxbq %1, %0" : "=x"(r3) : "x"(x));
+    __asm__ volatile("pmovsxwq %1, %0" : "=x"(r4) : "x"(x));
+    __asm__ volatile("vpmovzxbq %1, %0" : "=x"(r5) : "m"(*(const uint16_t *)m));
+    __asm__ volatile("vpmovzxwq %1, %0" : "=x"(r6) : "m"(*(const uint32_t *)((const char *)m + 3)));
+    __asm__ volatile("vpmovsxbq %1, %0" : "=x"(r7) : "m"(*(const uint16_t *)((const char *)m + 9)));
+    __asm__ volatile("vpmovsxwq %1, %0" : "=x"(r8) : "x"(x));
+    const __m128i all[8] = {r1, r2, r3, r4, r5, r6, r7, r8};
+    uint64_t r = 0;
+    for (int i = 0; i < 8; ++i)
+        r = r * 31 + (uint64_t)_mm_cvtsi128_si64(all[i]) * 7 + (uint64_t)_mm_extract_epi64(all[i], 1);
+    return r;
+}
