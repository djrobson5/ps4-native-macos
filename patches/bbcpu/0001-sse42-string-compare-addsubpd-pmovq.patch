+/* ---- SSE4.2 string compare: (V)PCMPISTRI/M and (V)PCMPESTRI/M ----
+ * Written from the Intel SDM's description (comparison, aggregation, polarity, output). A guest C
+ * library's strchr and relatives use them. The first operand is the reg1 string
+ * (xmm1; strchr's needle), the second the reg2 one (xmm2/m128; the text). Result flags: CF = some
+ * bit set, ZF = the second string ends inside the register, SF = the first ends, OF = bit 0;
+ * AF and PF are cleared. */
+static int pcmp_element(const BbVec *v, int i, int words, int is_signed) {
+    if (words) return is_signed ? (int)v->sw[i] : (int)v->w[i];
+    return is_signed ? (int)v->sb[i] : (int)v->b[i];
+}
+static void pcmpstr(BbCpu *cpu, const BbInsn *in, int explicit_length, int mask_form) {
+    const BbOp *o1 = &in->op[0], *o2 = &in->op[1];
+    const int imm = (int)in->op[in->count - 1].disp;
+    const BbVec a = vread(cpu, in, o1), b = vread(cpu, in, o2);
+    const int words = imm & 1, is_signed = (imm >> 1) & 1, agg = (imm >> 2) & 3, polarity = (imm >> 4) & 3;
+    const int n = words ? 8 : 16;
+    int la = n, lb = n;
+    if (explicit_length) {
+        int64_t x = (int32_t)cpu->r[RAX], y = (int32_t)cpu->r[RDX];
+        if (x < 0) x = -x;
+        if (y < 0) y = -y;
+        la = x > n ? n : (int)x; lb = y > n ? n : (int)y;
+    } else {
+        for (la = 0; la < n && pcmp_element(&a, la, words, 0); ++la) {}
+        for (lb = 0; lb < n && pcmp_element(&b, lb, words, 0); ++lb) {}
+    }
+    /* BoolRes[i][j]: first operand element i against second operand element j. */
+    int bool_res[16][16];
+    for (int i = 0; i < n; ++i)
+        for (int j = 0; j < n; ++j) {
+            const int x = pcmp_element(&a, i, words, is_signed), y = pcmp_element(&b, j, words, is_signed);
+            const int valid_i = i < la, valid_j = j < lb;
+            int r;
+            if (agg == 1) { /* ranges: elements pair up as (lower, upper) bounds */
+                r = valid_i && valid_j && ((i & 1) ? y <= x : y >= x);
+            } else if (agg == 0) { /* equal any */
+                r = valid_i && valid_j && x == y;
+            } else if (agg == 2) { /* equal each */
+                r = !valid_i && !valid_j ? 1 : (valid_i && valid_j && x == y);
+            } else { /* equal ordered */
+                r = !valid_i ? 1 : (valid_j && x == y);
+            }
+            bool_res[i][j] = r;
+        }
+    unsigned int_res1 = 0;
+    for (int j = 0; j < n; ++j) {
+        int r = 0;
+        switch (agg) {
+        case 0: for (int i = 0; i < n; ++i) r |= bool_res[i][j]; break;
+        case 1: for (int i = 0; i + 1 < n; i += 2) r |= bool_res[i][j] && bool_res[i + 1][j]; break;
+        case 2: r = bool_res[j][j]; break;
+        default: r = 1; for (int k = 0; k < n - j; ++k) r &= bool_res[k][j + k]; break;
+        }
+        int_res1 |= (unsigned)(r != 0) << j;
+    }
+    const unsigned all = (1u << n) - 1;
+    unsigned int_res2 = int_res1;
+    if (polarity == 1) int_res2 = ~int_res1 & all;
+    else if (polarity == 3) {
+        for (int j = 0; j < lb; ++j) int_res2 ^= 1u << j;
+    }
+    if (mask_form) {
+        BbVec m;
+        memset(&m, 0, sizeof(m));
+        if (imm & 0x40) {
+            for (int j = 0; j < n; ++j)
+                if (int_res2 >> j & 1) { if (words) m.w[j] = 0xffff; else m.b[j] = 0xff; }
+        } else m.q[0] = int_res2;
+        BbVec *x0 = &cpu->v[0];
+        memcpy(x0->b, m.b, 16);
+        if (in->vex) memset(x0->b + 16, 0, 16);
+    } else {
+        int index = n;
+        if (int_res2) {
+            if (imm & 0x40) { index = n - 1; while (!(int_res2 >> index & 1)) --index; }
+            else { index = 0; while (!(int_res2 >> index & 1)) ++index; }
+        }
+        cpu->r[RCX] = (uint32_t)index;
+    }
+    cpu->flags = (cpu->flags & ~(uint64_t)F_ARITH) | (int_res2 ? F_CF : 0) | (lb < n ? F_ZF : 0) |
+                 (la < n ? F_SF : 0) | ((int_res2 & 1) ? F_OF : 0);
+}
